{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "../../shared/**/*.ts",
    "../../shared/**/*.d.ts",
    "../../shared/senate-vote-menu.mjs",
    "../../shared/ingest-monitor-status.mjs"
  ],
  "exclude": ["node_modules", "../../shared/**/*.test.ts"]
}

