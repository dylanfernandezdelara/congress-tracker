# Copy to workers/senate_data_worker/wrangler.remote.toml (git-ignored) and fill
# in the real production D1 database_id from the Cloudflare
# dashboard. Use this manually when you want a local worker to read remote
# Cloudflare resources:
#
#   wrangler dev --config wrangler.remote.toml --remote
#
# so the local worker reads from REAL production D1 instead of Miniflare.
#
# This config intentionally uses the READ-ONLY entry (src/remote-readonly.ts),
# NOT src/worker.ts: the full worker's /__pipeline/* admin routes bypass auth for
# localhost callers, which against production D1 would let a local request trigger
# ingestion/materialization on prod. The read-only entry exposes only the public
# read API. Do NOT deploy with this config; deploys still use wrangler.toml.

name = "senate-data-api-worker"
main = "src/remote-readonly.ts"
compatibility_date = "2025-12-10"

[limits]
cpu_ms = 300000

[vars]
CONGRESS = "119"
SESSION = "2"
TARGET_STATE = "ALL"

[[d1_databases]]
binding = "SENATE_DB"
# Replace with the real production database name + id from the Cloudflare
# dashboard (D1 > your database > "database_id"):
database_name = "REPLACE_WITH_PROD_DB_NAME"
database_id = "REPLACE_WITH_PROD_DB_ID"
