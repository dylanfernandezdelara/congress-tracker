CONGRESS_API_KEY=your_congress_api_key
GOVINFO_API_KEY=your_govinfo_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free,arcee-ai/trinity-large-preview:free,openrouter/free
OPENROUTER_APP_REFERER=https://your-site.example
OPENROUTER_APP_TITLE=congress_tracker_worker
OPENROUTER_SHADOW_MODE=false
OPENROUTER_CANARY_PERCENT=100
OPENROUTER_MAX_NEW_ANALYSES=20
QUALITY_MIN_CLAIMS_COVERAGE=70
QUALITY_MIN_QUOTE_VALIDITY=80
QUALITY_MAX_CONFIDENCE_MISMATCH=35
QUALITY_HARD_GATES=false
# Use * for local dev (Vite :5173 → API :8787). Set a specific origin in production secrets.
ALLOWED_ORIGIN=*
DATA_FRESHNESS_MAX_HOURS=36
EVIDENCE_MAX_BILLS=30
EVIDENCE_BILL_CONCURRENCY=2
EVIDENCE_ENDPOINT_FANOUT=3
ACTIVITY_LOOKBACK_DAYS=30
