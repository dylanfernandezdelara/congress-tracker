# Live ingestion (Congress.gov / GovInfo) — required only for live data pulls
CONGRESS_API_KEY=your_congress_api_key
GOVINFO_API_KEY=your_govinfo_api_key

# CORS: use * for local dev (Vite :5173 -> API :8787); set a specific origin in prod
ALLOWED_ORIGIN=*

# Evidence thresholds use code defaults; override via EVIDENCE_* /
# ACTIVITY_LOOKBACK_DAYS / DATA_FRESHNESS_MAX_HOURS env vars when actively tuning.
