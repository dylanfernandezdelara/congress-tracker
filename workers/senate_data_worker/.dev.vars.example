# CORS: use * for local dev (Vite :5173 -> API :8787); set a specific origin in prod
ALLOWED_ORIGIN=*

# Local-only: allow POST /__pipeline/run/* without PIPELINE_ADMIN_TOKEN (never set in production).
# Must be exactly 1 (not true). Restart `npm run dev:worker` after editing .dev.vars — wrangler
# does not hot-reload this file. If PIPELINE_ADMIN_TOKEN is set below, it takes precedence and
# DEV_OPEN_PIPELINE is ignored (use Authorization: Bearer <token> instead).
DEV_OPEN_PIPELINE=1

# Local-only synthetic disclosure seeding (POST /__pipeline/run/disclosures). Never set in production.
ENABLE_SAMPLE_DISCLOSURES=1

# Copy to .dev.vars and set locally (never commit real values):
# CONGRESS_API_KEY=...
# OPENROUTER_API_KEY=...
# Optional override — must be a free OpenRouter model (e.g. google/gemma-4-31b-it:free).
# When unset, the worker picks the highest Artificial Analysis intelligence_index free model.
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# PIPELINE_ADMIN_TOKEN=  # when set, POST with Authorization: Bearer <token>
