# Local dev defaults to replay fixtures (no live API keys required).
#
# `wrangler dev` reads this file (and wrangler.toml [vars]) — it does NOT read
# the shell's process.env. On Cursor Cloud, set CONGRESS_API_KEY / GOVINFO_API_KEY /
# PIPELINE_ADMIN_TOKEN (and optionally DATA_SOURCE) in the Secrets dashboard; the
# setup script (scripts/cursor-cloud-setup.sh) bridges those env values into
# .dev.vars on start, so the same secrets work locally and in the cloud.
DATA_SOURCE=replay
REPLAY_FIXTURE_SET=canonical

# Live ingestion (Congress.gov / GovInfo) — set real keys and switch DATA_SOURCE to live
# when intentionally pulling from upstream.
CONGRESS_API_KEY=your_congress_api_key
GOVINFO_API_KEY=your_govinfo_api_key

# CORS: use * for local dev (Vite :5173 -> API :8787); set a specific origin in prod
ALLOWED_ORIGIN=*

# Evidence thresholds use code defaults; when actively tuning, add EVIDENCE_* /
# ACTIVITY_LOOKBACK_DAYS / DATA_FRESHNESS_MAX_HOURS lines here (they are not in
# the setup script's bridge list, so `wrangler dev` only picks them up from this
# file or wrangler.toml [vars], not from process.env).
