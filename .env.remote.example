# Copy to .env.remote (git-ignored) and fill in values for your Cloudflare
# deployment. Sourced automatically by scripts/dev-all.sh and
# scripts/refresh-remote.sh.

# Required for `npm run dev` (live mode) if wrangler isn't already logged in.
# Generate at https://dash.cloudflare.com/profile/api-tokens with permissions:
#   - Account: D1:Read, Workers R2 Storage:Read
# Leaving this empty will fall back to your `wrangler login` session if one
# exists.
CLOUDFLARE_API_TOKEN=

# Required for `npm run refresh:remote`. URL of the DEPLOYED pipeline worker.
# Example: https://senate-data-pipeline-worker.<your-subdomain>.workers.dev
DEPLOYED_PIPELINE_URL=

# Required for `npm run refresh:remote`. Shared secret used to authenticate
# against the deployed pipeline worker's /__pipeline/run/* endpoints.
# Set the same value on the deployed worker with:
#   wrangler secret put PIPELINE_ADMIN_TOKEN --config wrangler.pipeline.toml
PIPELINE_ADMIN_TOKEN=

# Optional. Skip materialization after a forced ingestion (default: 1 = run it).
# MATERIALIZE_AFTER=1
