# Copy to .env.remote (git-ignored) when you need to inspect deployed
# Cloudflare resources or manually call the deployed worker's pipeline routes.
# Source it in your shell before running remote wrangler/curl commands.

# Optional for remote wrangler commands if wrangler is not already logged in.
# Generate at https://dash.cloudflare.com/profile/api-tokens with permissions:
#   - Account: D1:Read
# Leaving this empty will fall back to your `wrangler login` session if one
# exists.
CLOUDFLARE_API_TOKEN=

# Optional. URL of the deployed worker for manual /__pipeline/* admin calls.
# The unified worker serves both the public API and the pipeline routes.
# Example: https://senate-data-api-worker.<your-subdomain>.workers.dev
DEPLOYED_PIPELINE_URL=

# Required on the deployed worker before /__pipeline/status and
# /__pipeline/run/* execute for non-local callers. Send as
# `Authorization: Bearer $PIPELINE_ADMIN_TOKEN` (prefer POST for /__pipeline/run/*).
# Set the same value on the deployed worker with:
#   wrangler secret put PIPELINE_ADMIN_TOKEN --config wrangler.toml
PIPELINE_ADMIN_TOKEN=
